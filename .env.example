# AI email generation
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional public research through Google Programmable Search / Custom Search JSON API.
GOOGLE_SEARCH_API_KEY=replace-with-google-search-api-key
GOOGLE_SEARCH_CX=replace-with-programmable-search-engine-id
# These aliases are also supported:
# GOOGLE_CUSTOM_SEARCH_API_KEY=replace-with-google-search-api-key
# GOOGLE_CUSTOM_SEARCH_CX=replace-with-programmable-search-engine-id
AI_REQUEST_TIMEOUT_MS=60000
DAILY_AI_GENERATION_LIMIT=10
ENRICHMENT_CACHE_TTL_MS=1800000

# Email delivery
# Use "resend" to send through the Resend HTTPS API instead of SMTP.
# Keep "smtp" if you want Gmail/app-password delivery.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL="Jobs Territory <noreply@jobsterritory.co.in>"

# SMTP fallback settings, only used when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=replace-with-smtp-from-email
